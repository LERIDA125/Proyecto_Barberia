NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://usuario:password@localhost:5432/barberia?schema=public"
SESSION_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Barberia
WEBAUTHN_ORIGIN=http://localhost:3000
VENTANA_CANCELACION_HORAS=0

# --- Asistente (CU-06) ---
# Proveedor: "groq" (cloud) o "ollama" (local)
LLM_PROVIDER=groq
# El plan actual no incluye llama-3.1-8b-instant (Groq lo retiró). Alternativas activas:
#   qwen/qwen3.8-27b | openai/gpt-oss-20b | openai/gpt-oss-120b
LLM_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=pega-aqui-tu-GROQ_API_KEY
OLLAMA_BASE_URL=http://localhost:11434
ASISTENTE_TOP_K=4
ASISTENTE_DOC=../datos_barberia.md

# --- Integración Google Calendar vía MCP externo (CU-07) ---
# URL del servidor MCP (transporte Streamable HTTP / SSE). Vacío = integración deshabilitada.
# El backend es cliente MCP: NUNCA llama a la API de Google directamente.
MCP_CALENDAR_URL=
# Token opcional para autenticar contra el servidor MCP (Bearer).
MCP_CALENDAR_TOKEN=
# ID del calendario destino gestionado por el MCP (ej. primary).
CALENDAR_ID=primary
# Zona horaria usada al crear/actualizar eventos.
TIMEZONE=America/Argentina/Buenos_Aires
# Timeout (ms) por cada llamada al servidor MCP.
MCP_CALENDAR_TIMEOUT_MS=5000

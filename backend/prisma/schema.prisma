generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  cliente
  barbero
  admin
}

enum EstadoTurno {
  pendiente
  confirmado
  cancelado
  completado
  ausente
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  telefono     String?
  passwordHash String?  @map("password_hash")
  rol          Rol      @default(cliente)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  barbero        Barbero?
  turnos         Turno[]             @relation("TurnosCliente")
  credenciales   CredencialPasskey[]
  notificaciones Notificacion[]
  conversaciones Conversacion[]

  @@map("usuarios")
}

model Barbero {
  id            String    @id @default(uuid())
  usuarioId     String    @unique @map("usuario_id")
  especialidad  String?
  horarioInicio DateTime? @map("horario_inicio") @db.Time(0)
  horarioFin    DateTime? @map("horario_fin") @db.Time(0)
  diasLaborales Int[]     @default([]) @map("dias_laborales")
  activo        Boolean   @default(true)

  usuario  Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  turnos   Turno[]   @relation("TurnosBarbero")
  bloqueos Bloqueo[]

  @@map("barberos")
}

model Bloqueo {
  id        String   @id @default(uuid())
  barberoId String   @map("barbero_id")
  inicio    DateTime
  fin       DateTime
  motivo    String?

  barbero Barbero @relation(fields: [barberoId], references: [id], onDelete: Cascade)

  @@index([barberoId, inicio])
  @@map("bloqueos")
}

model Servicio {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?
  duracionMin Int     @map("duracion_min")
  precio      Decimal @db.Decimal(10, 2)
  activo      Boolean @default(true)

  turnos Turno[]

  @@map("servicios")
}

model Turno {
  id            String      @id @default(uuid())
  clienteId     String      @map("cliente_id")
  barberoId     String      @map("barbero_id")
  servicioId    String      @map("servicio_id")
  fechaInicio   DateTime    @map("fecha_inicio")
  fechaFin      DateTime    @map("fecha_fin")
  estado        EstadoTurno @default(pendiente)
  notas         String?
  googleEventId String?     @map("google_event_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  cliente  Usuario  @relation("TurnosCliente", fields: [clienteId], references: [id])
  barbero  Barbero  @relation("TurnosBarbero", fields: [barberoId], references: [id])
  servicio Servicio @relation(fields: [servicioId], references: [id])

  @@index([barberoId, fechaInicio])
  @@index([clienteId, fechaInicio])
  @@map("turnos")
}

model CredencialPasskey {
  id           String   @id @default(uuid())
  usuarioId    String   @map("usuario_id")
  credentialId String   @unique @map("credential_id")
  publicKey    String   @map("public_key")
  counter      Int      @default(0)
  transports   String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("credenciales_passkey")
}

model Notificacion {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  titulo    String
  mensaje   String
  leida     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, createdAt])
  @@map("notificaciones")
}

model Conversacion {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  mensajes  Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, updatedAt])
  @@map("conversaciones")
}
